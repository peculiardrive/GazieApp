# ==========================================
# GAZIE COMMUTE - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. SUPABASE (Database, Auth, Storage)
# Obtain these from your Supabase Dashboard: Project Settings > API
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------
# 2. PAYSTACK (Live / Sandbox Payment Gateway)
# Obtain these from Paystack Dashboard: Settings > API Keys & Webhooks
# ------------------------------------------
# Test keys (for sandbox testing):
# PAYSTACK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Live keys (for production deployment):
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here

# ------------------------------------------
# 3. FEATURE TOGGLES
# Enable or disable the ₦50 platform booking fee requirement
# ------------------------------------------
NEXT_PUBLIC_PLATFORM_FEE_ENABLED=true

# ------------------------------------------
# 4. APP METADATA
# ------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.gazie.ng
